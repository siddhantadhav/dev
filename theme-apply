#!/usr/bin/env bash
# theme-apply — render templates/ for the current theme into ~/.config/dev/theme,
# point app configs at them and live-reload whatever is running. No sudo: the
# system-wide parts (SDDM, folder colours, browsers) are runs/shared/13-theme-system.
# Pick the theme with ./theme-switch; this just applies what ~/.config/dev/env says.
set -euo pipefail

cd "$(dirname "$0")"
export DEV_ROOT="$PWD"
source ./lib.sh
source ./themes/_lib.sh

theme_load "${DEV_THEME:-$DEV_THEME_DEFAULT}" ${DEV_ACCENT:+"$DEV_ACCENT"}
log "theme: $FAMILY-$VARIANT ($MODE), accent $ACCENT"

OUT="$HOME/.config/dev/theme"
mkdir -p "$OUT"
for t in templates/*; do
    theme_render "$t" "$OUT/$(basename "$t")"
done

# like lib.sh's link(), but the source is a rendered file outside the repo
link_rendered() {
    local src="$OUT/$1" dst="$2"
    [[ -L "$dst" && "$(readlink "$dst")" == "$src" ]] && return 0
    mkdir -p "$(dirname "$dst")"
    if [[ -e "$dst" && ! -L "$dst" ]]; then
        mv "$dst" "$dst.bak.$(date +%Y%m%d%H%M%S)"
        log "backed up $dst"
    fi
    ln -sfn "$src" "$dst"
}

# kitty, tmux, hyprland, hyprlock, rofi and nvim include the rendered files directly.
# lazygit gets it via LG_CONFIG_FILE (configs/shared/dev-profile.sh), which
# fails if any listed file is missing.
mkdir -p "$HOME/.config/lazygit"
touch "$HOME/.config/lazygit/config.yml"

# --- Linux desktop -------------------------------------------------------------
if [[ "$DEV_OS" != macos ]]; then
    link_rendered dunstrc          "$HOME/.config/dunst/dunstrc"
    link_rendered gtk-settings.ini "$HOME/.config/gtk-3.0/settings.ini"
    link_rendered gtk-settings.ini "$HOME/.config/gtk-4.0/settings.ini"
    link_rendered kvantum.kvconfig "$HOME/.config/Kvantum/kvantum.kvconfig"
    # waybar's style.css is tracked and @imports this sibling (gitignored) link,
    # which resolves whether waybar starts via ~/.config/waybar or reload.sh
    [[ "$DEV_DESKTOP" == hyprland ]] &&
        link_rendered waybar.css   "$DEV_ROOT/configs/hyprland/waybar/theme.css"

    # GTK is adw-gtk3 / libadwaita recoloured: libadwaita ignores gtk-theme-name
    # and reads only ~/.config/gtk-4.0/gtk.css; adw-gtk3 takes the same colours
    # from ~/.config/gtk-3.0/gtk.css
    link_rendered gtk4.css "$HOME/.config/gtk-4.0/gtk.css"
    link_rendered gtk3.css "$HOME/.config/gtk-3.0/gtk.css"
    # links to a GTK theme's own files, from before
    for f in gtk-dark.css assets; do
        [[ -L "$HOME/.config/gtk-4.0/$f" ]] && rm "$HOME/.config/gtk-4.0/$f"
    done

    if command -v gsettings >/dev/null 2>&1; then
        gs() { gsettings set org.gnome.desktop.interface "$@"; }
        gs color-scheme "prefer-$MODE"
        gs gtk-theme    "$GTK_THEME"
        gs icon-theme   "$ICON_THEME"
        gs cursor-theme "$CURSOR_THEME"
        gs cursor-size  24
        # libadwaita's accent (buttons, toggles, selections); GNOME 47+
        gs accent-color "$GNOME_ACCENT" 2>/dev/null || true
    fi

    # GNOME Shell (top bar, quick settings, notifications, overview, OSDs, lock
    # screen): the installed shell's own stylesheet in the theme's colours, set
    # through the User Themes extension (runs/desktop-gnome)
    shell_schema=org.gnome.shell.extensions.user-theme
    if [[ "$DEV_DESKTOP" == gnome ]] && gsettings list-keys "$shell_schema" >/dev/null 2>&1; then
        shell_dir="$THEME_DATA/themes/$SHELL_THEME/gnome-shell"
        mkdir -p "$shell_dir"
        "$DEV_ROOT/themes/gnome-shell-recolor" "$OUT/colors.json" "$shell_dir/gnome-shell.css" "$BAR_GLASS_FRAC"
        gsettings set "$shell_schema" name "$SHELL_THEME"
        for d in "$THEME_DATA"/themes/dev-*; do
            [[ "$d" == "$THEME_DATA/themes/$SHELL_THEME" ]] || rm -rf "$d"
        done
    fi

    # Flatpak apps can't see ~/.config/gtk-{3,4}.0 or ~/.local/share/icons by
    # default; GTK3 ones get adw-gtk3 itself from Flathub (runs/shared/12-theme-pkgs)
    if command -v flatpak >/dev/null 2>&1; then
        flatpak override --user \
            --filesystem=xdg-config/gtk-3.0:ro --filesystem=xdg-config/gtk-4.0:ro \
            --filesystem=xdg-data/themes:ro --filesystem=xdg-data/icons:ro \
            --unset-env=GTK_THEME
    fi
fi

# Electron apps don't take GTK themes, only dark/light. Teams for Linux (the
# package or the Flatpak, when installed) follows the system's when told to;
# this sets just that key in its config.json.
for teams in "$HOME/.config/teams-for-linux" \
             "$HOME/.var/app/com.github.IsmaelMartinez.teams_for_linux/config/teams-for-linux"; do
    [[ -d "$teams" ]] || continue
    python3 - "$teams/config.json" <<'PY'
import json, os, sys
path = sys.argv[1]
try:
    with open(path) as f:
        config = json.load(f)
except FileNotFoundError:
    config = {}
if config.get("appearance", {}).get("followSystemTheme") is not True:
    config.setdefault("appearance", {})["followSystemTheme"] = True
    with open(path + ".tmp", "w") as f:
        json.dump(config, f, indent=2)
        f.write("\n")
    os.replace(path + ".tmp", path)
PY
done

# --- live reload ---------------------------------------------------------------
# each is a no-op when the app isn't running (e.g. during a fresh ./run)
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl reload >/dev/null
    hyprctl setcursor "$CURSOR_THEME" 24 >/dev/null || true   # theme not installed yet
fi
pkill -USR1 -x kitty  || true   # kitty: reload config
pkill -USR2 -x waybar || true   # waybar: reload config + style
if pgrep -x dunst >/dev/null; then dunstctl reload; fi
if tmux has-session 2>/dev/null; then tmux source-file "$OUT/tmux.conf"; fi
# nvim watches $OUT/nvim.lua itself (configs/shared/nvim/lua/siddhant/theme.lua)

log "applied (GTK/Qt apps pick it up when reopened)"
