# generated by ~/dev/theme-apply from ~/dev/templates — edit there, not here
[global]
    font = JetBrainsMono Nerd Font 10
    corner_radius = 10
    frame_width = 2
    frame_color = "${accent}"
    separator_color = frame
    highlight = "${accent}"

[urgency_low]
    background = "${bg}"
    foreground = "${fg_dim}"

[urgency_normal]
    background = "${bg}"
    foreground = "${fg}"

[urgency_critical]
    background = "${bg}"
    foreground = "${fg}"
    frame_color = "${red}"
