/* generated by ~/dev/theme-apply from ~/dev/templates — edit there, not here */
configuration {
    icon-theme: "${ICON_THEME}";
}

* {
    font:             "JetBrainsMono Nerd Font 12";
    glass:            ${bg}${GLASS_HEX};
    fg:               ${fg};
    fg-dim:           ${fg_dim};
    surface:          ${surface};
    accent:           ${accent};
    accent-tint:      ${accent}38;    /* 22%: tint behind the selected row */
    red:              ${red};
    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            560px;
    padding:          8px;
    border:           2px;
    border-color:     @accent;
    border-radius:    12px;
    background-color: @glass;
}

mainbox {
    spacing:  8px;
    children: [ inputbar, message, listview ];
}

/* the field you type in stays solid, so the query is always crisp */
inputbar {
    padding:          8px 12px;
    spacing:          10px;
    border-radius:    8px;
    background-color: @surface;
    children:         [ prompt, entry ];
}
prompt { text-color: @accent; }
entry {
    placeholder:       "search";
    placeholder-color: @fg-dim;
    cursor:            text;
}

message {
    padding:          6px 12px;
    border-radius:    8px;
    background-color: @surface;
}

listview {
    lines:        8;
    fixed-height: false;
    scrollbar:    false;
    spacing:      2px;
}

element {
    padding:       6px 10px;
    spacing:       10px;
    border-radius: 8px;
    cursor:        pointer;
}
/* tint behind the row + normal text colour: readable at any accent */
element selected.normal,
element selected.active,
element selected.urgent  { background-color: @accent-tint; }
element normal.active,
element alternate.active { text-color: @accent; }
element normal.urgent,
element alternate.urgent { text-color: @red; }

element-icon { size: 1.3em; cursor: inherit; }
element-text {
    text-color:     inherit;
    vertical-align: 0.5;
    highlight:      bold ${accent};   /* the part your search matched */
    cursor:         inherit;
}

