#!/usr/bin/env bash
# System-wide (sudo) side of the current theme, on every OS: SDDM, Papirus
# folder colour, browser theme. Steps for what isn't installed are skipped. Each step only touches /etc or /usr when its value changed.
# The userland side is theme-apply; ./theme-switch runs both.
set -e
source "$DEV_ROOT/themes/_lib.sh"
theme_load "${DEV_THEME:-$DEV_THEME_DEFAULT}" ${DEV_ACCENT:+"$DEV_ACCENT"}

# write_root <file> <content> — sudo-write only when different
write_root() {
    [[ -f "$1" && "$(cat "$1")" == "$2" ]] && return 0
    sudo install -d -m 755 "$(dirname "$1")"
    printf '%s\n' "$2" | sudo tee "$1" >/dev/null
    log "wrote $1"
}

# SDDM — themes without a port keep whatever is set
if [[ -n "$SDDM_THEME" && -d "/usr/share/sddm/themes/$SDDM_THEME" ]]; then
    write_root /etc/sddm.conf.d/theme.conf "[Theme]
Current=$SDDM_THEME"
fi

# Papirus folder colour (rewrites links inside /usr/share/icons/Papirus*).
# Arch has papirus-folders and the catppuccin colours as AUR packages; Fedora
# gets the script into ~/.local/bin and the colours copied in, as their READMEs say.
if [[ -n "$PAPIRUS_COLOR" && "$DEV_OS" == fedora && -d /usr/share/icons/Papirus ]]; then
    if ! command -v papirus-folders >/dev/null 2>&1; then
        mkdir -p "$HOME/.local/bin"
        curl -fsSL --retry 3 --retry-all-errors -o "$HOME/.local/bin/papirus-folders" \
            https://raw.githubusercontent.com/PapirusDevelopmentTeam/papirus-folders/master/papirus-folders
        chmod 755 "$HOME/.local/bin/papirus-folders"
        export PATH="$HOME/.local/bin:$PATH"
    fi
    if [[ ! -e "/usr/share/icons/Papirus/64x64/places/folder-$PAPIRUS_COLOR.svg" ]]; then
        src="$(fetch_pkg https://github.com/catppuccin/papirus-folders.git)"
        sudo cp -r "$src/src/." /usr/share/icons/Papirus/
        log "added the catppuccin folder colours to Papirus"
    fi
fi
if [[ -n "$PAPIRUS_COLOR" ]] && command -v papirus-folders >/dev/null 2>&1; then
    papirus=$([[ $MODE == dark ]] && echo Papirus-Dark || echo Papirus)
    # papirus-folders recolours by relinking folder.svg; read the colour from there
    # (its -l listing doesn't mark the current one in every version)
    current="$(readlink "/usr/share/icons/$papirus/64x64/places/folder.svg" 2>/dev/null || true)"
    current="${current#folder-}"; current="${current%.svg}"
    # full path: sudo's PATH has no ~/.local/bin
    [[ "$current" == "$PAPIRUS_COLOR" ]] || sudo "$(command -v papirus-folders)" -C "$PAPIRUS_COLOR" --theme "$papirus"
fi

# Browsers, via enterprise policy. Force-installing is the only scriptable way
# to set a theme; a theme without a browser port drops ours, so the browser
# falls back to its default. Takes effect on the browser's next start.
#
# Firefox also always gets Violentmonkey (a userscript manager, from Mozilla's
# add-on site) for configs/shared/userscripts: media-position keeps the song
# position that waybar's media module shows exact. Install the scripts with
# ./userscript-install. (This file owns policies.json, so it lives here.)
VIOLENTMONKEY='"{aecec67f-0d10-4fa7-b7c7-609a2db280cf}": { "installation_mode": "force_installed", "install_url": "https://addons.mozilla.org/firefox/downloads/latest/violentmonkey/latest.xpi" }'
# Linux reads /etc/firefox/policies; macOS only the app bundle's distribution folder
ff_policies=/etc/firefox/policies/policies.json
[[ "$DEV_OS" == macos ]] && ff_policies=/Applications/Firefox.app/Contents/Resources/distribution/policies.json
if command -v firefox >/dev/null 2>&1 || [[ "$DEV_OS" == macos && -d /Applications/Firefox.app ]]; then
    ext="$VIOLENTMONKEY"
    [[ -n "$FIREFOX_THEME" ]] && ext+=", \"$FIREFOX_THEME\": { \"installation_mode\": \"force_installed\", \"install_url\": \"$FIREFOX_THEME_URL\" }"
    write_root "$ff_policies" "{ \"policies\": { \"ExtensionSettings\": { $ext } } }"
fi
# Arch names the binary chromium, Fedora chromium-browser; both read /etc/chromium
if command -v chromium >/dev/null 2>&1 || command -v chromium-browser >/dev/null 2>&1; then
    list="[]"
    [[ -n "$CHROMIUM_THEME" ]] && list="[ \"$CHROMIUM_THEME\" ]"
    write_root /etc/chromium/policies/managed/dev-theme.json "{ \"ExtensionInstallForcelist\": $list }"
fi
