#!/usr/bin/env bash
# Make the browser in hypr/programs.lua (Super+B, the rofi launcher's web
# searches) the system default as well, so links clicked in any app open in
# it too. xdg-mime writes ~/.config/mimeapps.list, keeping its other entries.
set -e
browser="$(sed -n 's/^ *browser *= *"\([^"]*\)".*/\1/p' "$DEV_ROOT/configs/arch/hypr/programs.lua")"
desktop="$browser.desktop"
if [[ -z "$browser" || ! -f "/usr/share/applications/$desktop" ]]; then
    log "default browser: no /usr/share/applications/$desktop, leaving it as is"
    exit 0
fi
for type in x-scheme-handler/http x-scheme-handler/https text/html application/xhtml+xml; do
    if [[ "$(xdg-mime query default "$type")" != "$desktop" ]]; then
        xdg-mime default "$desktop" "$type"
        log "default for $type: $desktop"
    fi
done
