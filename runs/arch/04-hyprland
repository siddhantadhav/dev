#!/usr/bin/env bash
set -e

# the session and what its config/keybinds call (configs/arch/hypr):
#   kitty            terminal (programs.lua) + waybar popups
#   dunst, libnotify notifications + notify-send
#   pipewire stack   audio; wpctl for the volume keys and waybar
#   playerctl        media keys + waybar's now-playing
#   upower, power-profiles-daemon   waybar's battery module
pkgs=(
    hyprland kitty dunst libnotify
    pipewire pipewire-pulse wireplumber
    playerctl upower power-profiles-daemon
)
missing=()
for p in "${pkgs[@]}"; do pacman -Qq "$p" >/dev/null 2>&1 || missing+=("$p"); done
(( ${#missing[@]} )) && pkg_install "${missing[@]}"

systemctl is-enabled --quiet power-profiles-daemon || sudo systemctl enable --now power-profiles-daemon

link configs/arch/hypr "$HOME/.config/hypr"
