#!/usr/bin/env bash
# Packages for every theme in themes/ (GTK, Kvantum, cursors, SDDM, ...), so
# ./theme-switch never has to install anything. AUR, hence yay (02-aur-helper).
set -e
source "$DEV_ROOT/themes/_lib.sh"

pkgs=( papirus-icon-theme )
for t in $(theme_list); do
    # shellcheck disable=SC2207
    pkgs+=( $(theme_load "$t" >/dev/null && echo "$PACKAGES") )
done
yay -S --needed --noconfirm "${pkgs[@]}"
