#!/usr/bin/env bash
set -e

# The xdg-desktop-portal "appearance" interface broadcasts a color-scheme
# preference that GTK4/libadwaita, Qt 6.5+, Firefox, Chromium/Electron and
# VS Code all follow — so flipping this one signal darkens current AND future
# apps. xdg-desktop-portal-gtk reads the preference from gsettings, which
# theme-apply sets (prefer-dark / prefer-light) along with the GTK settings.ini.
pkg_install xdg-desktop-portal-gtk gsettings-desktop-schemas

# Qt5/Qt6: Kvantum gives one theme for both versions, driven by the
# QT_STYLE_OVERRIDE=kvantum env set in configs/hyprland/hypr/environment.lua;
# theme-apply writes ~/.config/Kvantum/kvantum.kvconfig.
pkg_install kvantum kvantum-qt5
