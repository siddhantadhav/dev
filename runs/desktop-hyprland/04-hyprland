#!/usr/bin/env bash
set -e

# the session and what its config/keybinds call (configs/hyprland/hypr):
#   kitty            terminal (programs.lua) + waybar popups
#   dunst, libnotify notifications + notify-send
#   pipewire stack   audio; wpctl for the volume keys and waybar
#   playerctl        media keys + waybar's now-playing
#   upower, power-profiles-daemon   waybar's battery module
#   brightnessctl    the brightness keys
pkgs=(
    hyprland kitty dunst libnotify
    pipewire pipewire-pulse wireplumber
    playerctl upower power-profiles-daemon brightnessctl
)
pkg_install "${pkgs[@]}"

ppd=$([[ "$DEV_OS" == fedora ]] && echo tuned-ppd || echo power-profiles-daemon)
systemctl is-enabled --quiet "$ppd" || sudo systemctl enable --now "$ppd"

link configs/hyprland/hypr "$HOME/.config/hypr"
