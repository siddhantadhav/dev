#!/usr/bin/env bash
# GNOME as the desktop: it themes GTK apps, icons and the cursor itself from
# the gsettings that theme-apply writes; this adds what it lacks for the rest
# and the Shell extensions, which this script owns.
set -e

# Qt5/Qt6 through Kvantum (theme-apply writes ~/.config/Kvantum/kvantum.kvconfig).
# Hyprland sets QT_STYLE_OVERRIDE in hypr/environment.lua; a GNOME session reads
# ~/.config/environment.d instead. Takes effect on next login.
pkg_install kvantum kvantum-qt5
envd="$HOME/.config/environment.d/90-dev.conf"
want="QT_STYLE_OVERRIDE=kvantum"
if [[ "$(cat "$envd" 2>/dev/null)" != "$want" ]]; then
    mkdir -p "$(dirname "$envd")"
    printf '%s\n' "$want" > "$envd"
    log "wrote $envd (applies on next login)"
fi

# --- extensions ------------------------------------------------------------------
# Exactly these are enabled; anything turned on by hand (Extension Manager,
# extensions.gnome.org) is turned off again on the next run. Add it here to keep it.
pkg_install gnome-shell-extension-user-theme gnome-shell-extension-appindicator \
    gnome-shell-extension-just-perfection gnome-shell-extension-blur-my-shell
extensions=(
    user-theme@gnome-shell-extensions.gcampax.github.com  # shell theme (theme-apply)
    appindicatorsupport@rgcjonas.gmail.com                # tray icons, as in waybar
    just-perfection-desktop@just-perfection               # animation speed, no workspace popup
    blur-my-shell@aunetx                                  # glass top bar, blurred overview
)
# not wanted: half-transparent windows without blur, the Fedora logo on the
# wallpaper, the old Applications menu, and what Just Perfection does already
unwanted=(
    gnome-transparent-windows@sonersg.com
    transparent-window@pbxqdown.github.com
    background-logo@fedorahosted.org
    apps-menu@gnome-shell-extensions.gcampax.github.com
    disable-workspace-switcher@jbradaric.me
)

user_ext="$HOME/.local/share/gnome-shell/extensions"
for ext in "${unwanted[@]}"; do
    if [[ -d "$user_ext/$ext" ]]; then
        rm -rf "${user_ext:?}/$ext"
        log "removed extension $ext"
    fi
done
# hand-installed copies would shadow the packaged ones
for ext in "${extensions[@]}"; do
    if [[ -d "$user_ext/$ext" && -d "/usr/share/gnome-shell/extensions/$ext" ]]; then
        rm -rf "${user_ext:?}/$ext"
        log "removed the hand-installed $ext; the package's is used from the next login"
    fi
done

gs_list() { local l; l="$(printf "'%s', " "$@")"; echo "[${l%, }]"; }
gsettings set org.gnome.shell disable-user-extensions false
gsettings set org.gnome.shell enabled-extensions "$(gs_list "${extensions[@]}")"
# also the ones Fedora enables by default, so they stay off
gsettings set org.gnome.shell disabled-extensions "$(gs_list "${unwanted[@]}")"

# extension settings, written as plain dconf keys: an extension the running
# shell hasn't loaded yet has no schema gsettings could check them against
dset() { [[ "$(dconf read "$1")" == "$2" ]] || dconf write "$1" "$2"; }

jp=/org/gnome/shell/extensions/just-perfection
dset $jp/animation 4               # "faster": 0.6x GNOME's durations
dset $jp/workspace-popup false     # no popup on workspace switch, as on Hyprland
dset $jp/startup-status 0          # log in to the desktop, not the overview
dset $jp/support-notifier-type 0   # no donation notifications

bms=/org/gnome/shell/extensions/blur-my-shell
# pipelines carried over from older versions can have no blur effect at all
if [[ "$(dconf read $bms/pipelines)" == *"'effects': <@av []>"* ]]; then
    dconf reset $bms/pipelines
fi
dset $bms/panel/blur true
dset $bms/panel/static-blur true            # the wallpaper blurred once, not live
dset $bms/panel/override-background false   # the shell theme colours the bar
dset $bms/overview/blur true
dset $bms/appfolder/blur true
dset $bms/lockscreen/blur true
for k in applications dash-to-dock window-list screenshot coverflow-alt-tab; do
    dset $bms/$k/blur false
done
