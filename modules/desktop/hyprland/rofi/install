#!/usr/bin/env bash
# rofi: the Super+Space launcher and the waybar menus (wifi, power).
# Native Wayland since 2.0; fuzzy, case-insensitive search (config.rasi).
# The launcher (scripts/launcher) is one list of apps, Google search (in the
# browser set in hyprland/config/programs.lua), clipboard history (cliphist), files, ssh
# hosts and emoji (rofi-emoji; wtype types them in); typing = switches to a
# calculator (rofi-calc).
set -e
pkg_install rofi rofi-calc rofi-emoji wtype cliphist wl-clipboard
link config.rasi "$HOME/.config/rofi/config.rasi"
for s in launcher web clipboard files; do
    link "scripts/$s" "$HOME/.local/bin/rofi-$s"
done
# the theme it @imports is the rendered templates/rofi.rasi

# calculator (qalc): "5 kg to lb" gives 11.02 lb, not "11 lb + 0.37 oz"
qalc_cfg="$HOME/.config/qalculate/qalc.cfg"
if [[ -f "$qalc_cfg" ]]; then
    sed -i 's/^mixed_units_conversion=.*/mixed_units_conversion=0/' "$qalc_cfg"
    grep -q '^mixed_units_conversion=' "$qalc_cfg" ||
        sed -i 's/^\[General\]$/&\nmixed_units_conversion=0/' "$qalc_cfg"
else
    mkdir -p "$(dirname "$qalc_cfg")"
    printf '[General]\nmixed_units_conversion=0\n' > "$qalc_cfg"
fi

# clipboard history watchers: autostart.lua starts them with Hyprland; start
# them now too so history works before the next login
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    for type in text image; do
        pgrep -f "wl-paste --type $type --watch cliphist" >/dev/null ||
            setsid -f wl-paste --type "$type" --watch cliphist store >/dev/null 2>&1
    done
fi

# replaced by rofi: drop wofi and the links into this repo it left behind
for f in config style.css; do
    [[ -L "$HOME/.config/wofi/$f" ]] && rm "$HOME/.config/wofi/$f"
done
rmdir "$HOME/.config/wofi" 2>/dev/null || true
pkg_uninstall wofi
