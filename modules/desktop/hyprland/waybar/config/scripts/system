#!/usr/bin/env python3
"""system — waybar's system module: CPU · GPU · RAM · power, one line.

Runs continuously (waybar reads a JSON line every 2 s). Values turn
yellow/red when high; power shows watts only on battery — on AC nothing
measures total draw. Click: scripts/sysinfo (details) · right click: btop.
"""
import json
import sys
import time

import sysstat
from tui import colours

INTERVAL = 2


def label(text):
    return f"<span size='8pt' weight='bold' alpha='55%' letter_spacing='800'>{text}</span>"


def tone(value, warn, crit, c):
    """Wrap a value in yellow/red when it crosses warn/crit."""
    def wrap(text):
        if value is None or value < warn:
            return text
        return f"<span color='{c['red'] if value >= crit else c['yellow']}'>{text}</span>"
    return wrap


def main():
    cpu, gpu = sysstat.Cpu(), sysstat.Nvidia(INTERVAL * 1000)
    time.sleep(0.5)   # first CPU delta + first nvidia-smi line
    while True:
        c = colours()   # re-read: follows ./dev theme
        usage = cpu.usage()
        used, total, swap_used, _ = sysstat.memory()
        bat = sysstat.battery()
        temp = sysstat.cpu_temp()
        g = gpu.data

        parts = [f"{label('CPU')} " + tone(usage, 70, 90, c)(f"{usage:>2.0f}%")]
        if g and g["util"] is not None:
            parts.append(f"{label('GPU')} " + tone(g["util"], 70, 90, c)(f"{g['util']:>2.0f}%"))
        parts.append(f"{label('RAM')} " + tone(100 * used / total, 75, 90, c)(f"{used:.1f}G"))
        if bat and bat["watts"] is not None:
            parts.append(f"{label('PWR')} " + tone(bat["watts"], 25, 40, c)(f"{bat['watts']:.1f}W"))
        elif bat:
            parts.append(f"{label('PWR')} <span alpha='55%'>AC</span>")

        tip = [f"CPU {usage:.0f}% · {sysstat.cpu_freq_ghz():.1f} GHz"
               + (f" · {temp:.0f}°C" if temp is not None else "")]
        if g:
            tip.append(f"GPU {g['name']} {g['util'] or 0:.0f}% · {g['mem_used'] or 0:.0f}/{g['mem_total'] or 0:.0f} MiB"
                       + (f" · {g['temp']:.0f}°C" if g["temp"] is not None else ""))
        tip.append(f"RAM {used:.1f} of {total:.1f}G" + (f" · swap {swap_used:.1f}G" if swap_used >= 0.1 else ""))
        if bat:
            tip.append(f"Power {bat['watts']:.1f} W from battery" if bat["watts"] is not None
                       else f"Power: on AC ({bat['status'].lower()}) — draw is only measurable on battery")
        tip.append("\nclick: details · right click: btop")

        print(json.dumps({"text": "  ".join(parts), "tooltip": "\n".join(tip)}, ensure_ascii=False), flush=True)
        time.sleep(INTERVAL)


if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):   # waybar went away
        sys.exit(0)
