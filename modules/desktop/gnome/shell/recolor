#!/usr/bin/env python3
"""recolor <colors.json> <out.css> <panel opacity>

GNOME Shell's own stylesheet (from the installed shell, so it always matches
its version), recoloured with the theme rendered into colors.json
(modules/shared/appearance/templates). Used as a User Themes shell theme by
on-theme.

Adwaita's greys are mapped by lightness onto the theme's background-to-text
ramp, its reds/oranges/yellows by hue onto the theme's (keeping how much
lighter or darker each shade is), and the accent onto the theme's accent.
Colours it can't place are left as they are and listed on stderr.
"""
import colorsys
import json
import os
import re
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio  # noqa: E402

GRESOURCE = "/usr/share/gnome-shell/gnome-shell-theme.gresource"

colors_path, out_path, panel_alpha = sys.argv[1], sys.argv[2], float(sys.argv[3])
with open(colors_path) as f:
    theme = json.load(f)
dark = theme["mode"] == "dark"


def rgb(hex_):
    hex_ = hex_.lstrip("#")
    if len(hex_) == 3:
        hex_ = "".join(c * 2 for c in hex_)
    return tuple(int(hex_[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, t):
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


T = {k: rgb(v) for k, v in theme.items() if isinstance(v, str) and v.startswith("#")}
BLACK = (0, 0, 0)

# Adwaita grey level (0-255) -> theme colour, interpolated in between.
# Dark: overview #222226, OSDs #2e2e33, popups/dash #36363a-#38383b,
# hover/borders #47474c, dim text #9b9b9d, text #fafafb/#ffffff.
# Light keeps the overview, dash and OSDs dark, so the ramp runs from the
# theme's text (dark) to its base (light) and those stay dark too.
if dark:
    RAMP = [(0x00, T["bg_dim"]), (0x22, T["bg_alt"]), (0x2e, T["bg"]),
            (0x37, T["surface"]), (0x47, T["surface_alt"]),
            (0x9b, T["fg_dim"]), (0xfa, T["fg"]), (0xff, T["fg"])]
else:
    RAMP = [(0x00, mix(T["fg"], BLACK, 0.4)), (0x22, T["fg"]),
            (0x9b, T["overlay"]), (0xe6, T["surface"]),
            (0xfa, T["bg"]), (0xff, T["bg"])]


def grey(level):
    for (l0, c0), (l1, c1) in zip(RAMP, RAMP[1:]):
        if level <= l1:
            return mix(c0, c1, (level - l0) / (l1 - l0))
    return RAMP[-1][1]


# Adwaita's base shade of each status colour, which the theme's replaces
STATUS = {"red": rgb("#c01c28"),
          "orange": rgb("#ff7800" if dark else "#e66100"),
          "yellow": rgb("#cd9309" if dark else "#e5a50a")}

unmapped = set()


def recolor(c):
    r, g, b = c
    if max(c) - min(c) <= 16:
        if c == BLACK:
            return None   # shadows stay black
        return grey((r + g + b) / 3)
    h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
    deg = h * 360
    family = ("red" if deg < 15 or deg > 330 else
              "orange" if deg < 35 else
              "yellow" if deg < 60 else None)
    if family is None:
        unmapped.add("#%02x%02x%02x" % c)
        return None
    base_l = colorsys.rgb_to_hls(*(x / 255 for x in STATUS[family]))[1]
    th, tl, ts = colorsys.rgb_to_hls(*(x / 255 for x in T[family]))
    tl = min(1.0, max(0.0, tl + (l - base_l)))
    return tuple(round(x * 255) for x in colorsys.hls_to_rgb(th, tl, ts))


def hexs(c):
    return "#%02x%02x%02x" % c


COLOR = re.compile(r"#[0-9a-fA-F]{6}\b|#[0-9a-fA-F]{3}\b"
                   r"|rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*(?:,\s*([\d.]+)\s*)?\)"
                   r"|(?<![\w-])(?:white|black)(?![\w-])")


def sub_color(m):
    tok = m.group(0)
    if tok == "white":
        tok = "#ffffff"
    elif tok == "black":
        tok = "#000000"
    if tok.startswith("#"):
        new = recolor(rgb(tok))
        return hexs(new) if new else m.group(0)
    c = tuple(int(m.group(i)) for i in (1, 2, 3))
    new = recolor(c)
    if new is None:
        return m.group(0)
    alpha = m.group(4)
    return "rgba(%d, %d, %d, %s)" % (*new, alpha) if alpha else "rgb(%d, %d, %d)" % new


def sub_block(m):
    # only declarations: selectors like #dash or #panel stay untouched
    block = COLOR.sub(sub_color, m.group(0))
    block = block.replace("-st-accent-fg-color", theme["bg"])
    return block.replace("-st-accent-color", theme["accent"])


resource = Gio.Resource.load(GRESOURCE)
name = "gnome-shell-dark.css" if dark else "gnome-shell-light.css"
css = bytes(resource.lookup_data("/org/gnome/shell/theme/" + name, 0).get_data()).decode()
css = re.sub(r"\{[^{}]*\}", sub_block, css)

# the top bar as glass over Blur my Shell's blur, like waybar's islands
bar = "rgba(%d, %d, %d, %.2f)" % (*T["bg_dim"], panel_alpha)
css += f"""
/* dev: glass top bar (modules/desktop/gnome/shell/recolor) */
#panel {{ background-color: {bar}; }}
#panel:overview {{ background-color: transparent; }}
"""

with open(out_path + ".tmp", "w") as f:
    f.write(css)
os.replace(out_path + ".tmp", out_path)

if unmapped:
    print("recolor: left as they are: " + " ".join(sorted(unmapped)), file=sys.stderr)
