#!/usr/bin/env bash
# Neovim, with config/ as ~/.config/nvim. Its colours follow the theme:
# config/lua/siddhant/theme.lua watches the rendered templates/nvim.lua.
set -e
# tree-sitter CLI — nvim-treesitter's 'main' branch builds parsers from source
# and needs it on PATH
pkg_install neovim tree-sitter-cli
link config "$HOME/.config/nvim"
