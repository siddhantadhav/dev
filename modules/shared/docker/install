#!/usr/bin/env bash
# Docker Engine on Linux (Fedora's comes from the docker-ce repo,
# modules/os/fedora), Docker Desktop on macOS
set -e
pkg_install docker lazydocker
[[ "$DEV_OS" == macos ]] && exit 0

# socket activation: the daemon starts on first use instead of at boot
systemctl is-enabled --quiet docker.socket || sudo systemctl enable --now docker.socket

# run docker without sudo — takes effect on next login (or `newgrp docker`)
id -nG "$USER" | grep -qw docker || sudo usermod -aG docker "$USER"
