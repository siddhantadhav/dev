#!/usr/bin/env bash
# macOS prep, before every other module: Homebrew installs every package in packages
set -e
command -v brew >/dev/null 2>&1 && exit 0
for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do [[ -x "$b" ]] && exit 0; done
NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
