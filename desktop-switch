#!/usr/bin/env bash
# desktop-switch — pick this machine's desktop (runs/desktop-<name>).
# usage: ./desktop-switch <hyprland|gnome|none>
set -e
[[ -z "${1:-}" ]] && { echo "usage: ./desktop-switch <hyprland|gnome|none>"; exit 1; }
[[ "$1" == none || -d "$(dirname "$0")/runs/desktop-$1" ]] || { echo "no such desktop: $1"; exit 1; }

mkdir -p ~/.config/dev
# replace only our line; the env file also holds DEV_PROFILE/DEV_THEME/DEV_ACCENT
touch ~/.config/dev/env
{ grep -v '^export DEV_DESKTOP=' ~/.config/dev/env || true; echo "export DEV_DESKTOP=$1"; } > ~/.config/dev/env.tmp
mv ~/.config/dev/env.tmp ~/.config/dev/env
[[ "$1" == none ]] && exit 0
# install the desktop, then re-apply the theme for it (waybar, GNOME Shell, ...)
"$(dirname "$0")/run" "desktop-$1"
exec "$(dirname "$0")/theme-apply"
