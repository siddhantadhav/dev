# packages — every app once, with its package on each OS. Scripts install by
# the first column (pkg_install in lib.sh), so the same list works everywhere.
#
#   a,b                     several packages
#   aur:pkg                 Arch User Repository (yay, runs/arch/02-aur-helper)
#   copr:owner/project:pkg  Fedora COPR, enabled on first use
#   cask:pkg                Homebrew cask (GUI app)
#   github:owner/repo:asset release binary into ~/.local/bin ({arch} = uname -m)
#   -                       not available on that OS: skipped with a log line
#
# Names not listed here are installed as-is on every OS.

# name                  arch                        fedora                                  macos

# --- base ------------------------------------------------------------------------------------------
base-devel              base-devel                  -                                       -
git                     git                         git                                     git
curl                    curl                        curl                                    curl
unzip                   unzip                       unzip                                   unzip
python                  python                      python3                                 python
gettext                 gettext                     gettext                                 gettext

