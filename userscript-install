#!/usr/bin/env bash
# userscript-install — open the userscripts in configs/shared/userscripts in
# Firefox, where Violentmonkey (force-installed by runs/arch/13-theme-system)
# shows each one's install page: click Install. Firefox never lets anything
# install a userscript silently, so this one click is the manual step.
# Violentmonkey only offers .user.js links served over http(s), so the folder
# is served on 127.0.0.1 for two minutes.
# usage: ./userscript-install           every script in the folder
#        ./userscript-install <name>    e.g. media-position
set -euo pipefail

cd "$(dirname "$0")/configs/shared/userscripts"
if [[ -n "${1:-}" ]]; then
    scripts=("$1.user.js")
else
    scripts=(*.user.js)
fi
[[ -f "${scripts[0]}" ]] || { echo "no such userscript: ${scripts[0]}" >&2; exit 1; }

port=$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')
setsid -f timeout 120 python3 -m http.server --bind 127.0.0.1 "$port" >/dev/null 2>&1
sleep 0.5
for s in "${scripts[@]}"; do
    firefox "http://127.0.0.1:$port/$s"
done
echo "Firefox: click Install on each script's page (the link works for 2 minutes)."
