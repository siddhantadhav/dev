#!/usr/bin/env python3
"""weather — waybar weather click: 7-day forecast, one day at a time.

  ← → / scroll / click a day   previous / next day
  t                            back to today
  r                            refresh
  q / Esc                      close

Forecast: Open-Meteo (free, no key, local timezone). Location: wttr.in's IP
lookup — the same place the bar's weather-stats shows — cached for a day.
"""
import datetime as dt
import json
import time
import urllib.request
from pathlib import Path

from tui import BOLD, RESET, Screen, bg, colours, draw, fg, keys, width

CACHE = Path.home() / ".cache/dev-weather-location.json"
FORECAST = ("https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}"
            "&timezone=auto&forecast_days=7"
            "&current=temperature_2m,apparent_temperature,relative_humidity_2m,"
            "weather_code,wind_speed_10m,wind_direction_10m"
            "&daily=weather_code,temperature_2m_max,temperature_2m_min,"
            "precipitation_probability_max,sunrise,sunset,uv_index_max"
            "&hourly=temperature_2m,apparent_temperature,precipitation_probability,"
            "weather_code,wind_speed_10m")

# WMO weather codes → (description, Nerd Font icon)
WMO = {0: ("Clear", "󰖙"), 1: ("Mostly clear", "󰖙"), 2: ("Partly cloudy", "󰖕"),
       3: ("Overcast", "󰖐"), 45: ("Fog", "󰖑"), 48: ("Icy fog", "󰖑"),
       51: ("Light drizzle", "󰖗"), 53: ("Drizzle", "󰖗"), 55: ("Heavy drizzle", "󰖗"),
       56: ("Freezing drizzle", "󰖗"), 57: ("Freezing drizzle", "󰖗"),
       61: ("Light rain", "󰖗"), 63: ("Rain", "󰖖"), 65: ("Heavy rain", "󰖖"),
       66: ("Freezing rain", "󰖖"), 67: ("Freezing rain", "󰖖"),
       71: ("Light snow", "󰖘"), 73: ("Snow", "󰖘"), 75: ("Heavy snow", "󰖘"),
       77: ("Snow grains", "󰖘"), 80: ("Showers", "󰖖"), 81: ("Showers", "󰖖"),
       82: ("Violent showers", "󰖖"), 85: ("Snow showers", "󰖘"), 86: ("Snow showers", "󰖘"),
       95: ("Thunderstorm", "󰖓"), 96: ("Thunderstorm, hail", "󰖓"), 99: ("Thunderstorm, hail", "󰖓")}
COMPASS = "N NNE NE ENE E ESE SE SSE S SSW SW WSW W WNW NW NNW".split()


def get_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": "curl/8"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)


def location():
    try:
        cached = json.loads(CACHE.read_text())
        if time.time() - cached["at"] < 86400:
            return cached
    except (OSError, ValueError, KeyError):
        pass
    area = get_json("https://wttr.in/?format=j1")["nearest_area"][0]
    loc = {"at": time.time(), "lat": area["latitude"], "lon": area["longitude"],
           "name": f'{area["areaName"][0]["value"]}, {area["region"][0]["value"]}'}
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.write_text(json.dumps(loc))
    return loc


def fetch():
    loc = location()
    return loc["name"], get_json(FORECAST.format(**loc))


def describe(code):
    return WMO.get(code, ("—", "󰖐"))


def render(place, data, day, c):
    cur, daily, hourly = data["current"], data["daily"], data["hourly"]
    desc, icon = describe(cur["weather_code"])
    wind = COMPASS[round(cur["wind_direction_10m"] / 22.5) % 16]
    lines = [
        fg(c["fg_dim"]) + place + RESET,
        fg(c["accent"]) + BOLD + f"{icon}  {cur['temperature_2m']:.0f}°" + RESET
        + fg(c["fg"]) + f"  {desc}" + RESET
        + fg(c["fg_dim"]) + f"   feels {cur['apparent_temperature']:.0f}° · humidity "
        f"{cur['relative_humidity_2m']}% · wind {cur['wind_speed_10m']:.0f} km/h {wind}" + RESET,
        "",
    ]

    # day strip: one tab per day, the selected one highlighted
    tabs = []
    for i, date in enumerate(daily["time"]):
        d = dt.date.fromisoformat(date)
        name = "Today" if i == 0 else d.strftime("%a %d")
        _, dicon = describe(daily["weather_code"][i])
        label = f" {name} {dicon} {daily['temperature_2m_max'][i]:.0f}° "
        if i == day:
            tabs.append(bg(c["accent"]) + fg(c["bg"]) + BOLD + label + RESET)
        else:
            tabs.append(fg(c["fg_dim"]) + label + RESET)
    lines += [" ".join(tabs), ""]

    # the selected day, every 3 hours
    date = daily["time"][day]
    d_desc, _ = describe(daily["weather_code"][day])
    sunrise, sunset = daily["sunrise"][day][-5:], daily["sunset"][day][-5:]
    lines.append(fg(c["fg"]) + BOLD + dt.date.fromisoformat(date).strftime("%A %d %B") + RESET
                 + fg(c["fg_dim"]) + f"  ·  {d_desc}  ·  {daily['temperature_2m_max'][day]:.0f}° / "
                 f"{daily['temperature_2m_min'][day]:.0f}°  ·  rain {daily['precipitation_probability_max'][day]}%"
                 f"  ·  UV {daily['uv_index_max'][day]:.0f}  ·  󰖜 {sunrise}  󰖛 {sunset}" + RESET)
    lines.append("")
    header = f"{'time':>5}   {'':2}{'':16}{'temp':>5} {'feels':>6} {'rain':>6} {'wind':>9}"
    lines.append(fg(c["overlay"]) + header + RESET)
    now = dt.datetime.now().strftime("%Y-%m-%dT%H")
    for i, t in enumerate(hourly["time"]):
        if not t.startswith(date) or int(t[11:13]) % 3:
            continue
        h_desc, h_icon = describe(hourly["weather_code"][i])
        rain = hourly["precipitation_probability"][i]
        past = t[:13] < now[:13] and day == 0
        tone = c["overlay"] if past else c["fg"]
        rain_tone = c["blue"] if rain >= 40 and not past else tone
        lines.append(fg(tone) + f"{t[11:16]:>5}   {h_icon} {h_desc[:15]:<16}"
                     f"{hourly['temperature_2m'][i]:>4.0f}° {hourly['apparent_temperature'][i]:>5.0f}° "
                     + fg(rain_tone) + f"{rain:>5}%" + fg(tone)
                     + f" {hourly['wind_speed_10m'][i]:>4.0f} km/h" + RESET)
    lines += ["", fg(c["overlay"]) + "← → day · t today · r refresh · q close" + RESET]
    return lines, tabs


def main():
    with Screen():
        c = colours()
        draw([fg(c["fg_dim"]) + "loading forecast…" + RESET])
        try:
            place, data = fetch()
        except Exception as e:  # network down, API change: say so, allow retry
            place, data = None, str(e)
        day = 0

        def show():
            if place is None:
                return draw([fg(c["red"]) + f"couldn't load the forecast: {data}" + RESET, "",
                             fg(c["overlay"]) + "r retry · q close" + RESET]), None
            lines, tabs = render(place, data, day, c)
            return draw(lines), tabs

        (top, lefts), tabs = show()
        for key in keys(timeout=1):
            days = len(data["daily"]["time"]) if place else 1
            if key == "q":
                return
            if key in ("left", "wheel-up"):
                day = max(0, day - 1)
            elif key in ("right", "wheel-down"):
                day = min(days - 1, day + 1)
            elif key == "t":
                day = 0
            elif key == "r":
                draw([fg(c["fg_dim"]) + "refreshing…" + RESET])
                try:
                    place, data = fetch()
                except Exception as e:
                    place, data = None, str(e)
                day = min(day, len(data["daily"]["time"]) - 1) if place else 0
            elif isinstance(key, tuple) and tabs:
                _, col, row = key
                if row == top + 3:   # the day strip is the 4th line
                    x = lefts[3]
                    for i, tab in enumerate(tabs):
                        if x <= col < x + width(tab):
                            day = i
                            break
                        x += width(tab) + 1
            (top, lefts), tabs = show()


if __name__ == "__main__":
    main()
