#!/usr/bin/env bash
# power-menu — waybar's ⏻ button: pick an action in rofi (no wlogout needed).
set -euo pipefail

choice="$(printf '%s\n' \
    "󰌾  Lock" \
    "󰤄  Suspend" \
    "󰍃  Log out" \
    "󰜉  Reboot" \
    "󰐥  Shut down" |
    rofi -dmenu -i -p "power" -theme-str 'window { width: 260px; } listview { lines: 5; }')" || exit 0

case "$choice" in
    *Lock)       hyprlock ;;
    *Suspend)    hyprlock & sleep 0.5; systemctl suspend ;;
    *"Log out")  hyprctl dispatch 'hl.dsp.exit()' ;;
    *Reboot)     systemctl reboot ;;
    *"Shut down") systemctl poweroff ;;
esac
